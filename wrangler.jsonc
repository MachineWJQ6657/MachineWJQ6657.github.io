{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "idontknowanythingowo-site",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "idontknowanythingowo.cc",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "idontknowanythingowo-site",
      "database_id": "051adfe5-f2a9-4c32-8fd4-a3b74519b888",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {
    "enabled": true
  }
}
